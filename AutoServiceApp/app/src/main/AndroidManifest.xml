<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="AutoService"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <!-- Главная Activity -->
        <activity
            android:name="com.example.autoserviceapp.MainActivity"
            android:exported="true"
            android:label="AutoService"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Новая Activity для деталей клиента -->
        <activity
            android:name="com.example.autoserviceapp.ClientDetailActivity"
            android:label="Детали клиента"
            android:parentActivityName="com.example.autoserviceapp.MainActivity"
            android:exported="false"
            android:theme="@style/AppTheme">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="com.example.autoserviceapp.MainActivity" />
        </activity>

    </application>

</manifest>