<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Имя клиента:"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/et_client_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Например: Иван Иванов"
        android:maxLines="1"
        android:layout_marginBottom="15dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Телефон:"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/et_client_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Например: +7 (999) 123-45-67"
        android:maxLines="1"
        android:inputType="phone"
        android:layout_marginBottom="15dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Модель автомобиля:"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/et_client_car_model"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Например: Toyota Camry 2020"
        android:maxLines="1"
        android:layout_marginBottom="15dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Номер автомобиля:"
        android:layout_marginBottom="5dp" />

    <EditText
        android:id="@+id/et_client_license_plate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Например: A123BC777"
        android:maxLines="1"
        android:layout_marginBottom="10dp" />

</LinearLayout>