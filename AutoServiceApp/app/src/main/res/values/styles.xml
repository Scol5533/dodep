<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовый стиль приложения -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2196F3</item>
        <item name="colorPrimaryDark">#1976D2</item>
        <item name="colorAccent">#FF9800</item>
        <item name="android:windowBackground">@drawable/gradient_background</item>
        <item name="android:statusBarColor">#1565C0</item>
    </style>

    <!-- Стили кнопок -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="AppButton.Primary" parent="AppButton">
        <item name="backgroundTint">#2196F3</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:drawableTint">@android:color/white</item>
    </style>

    <style name="AppButton.Secondary" parent="AppButton">
        <item name="backgroundTint">#F5F5F5</item>
        <item name="android:textColor">#424242</item>
        <item name="android:drawableTint">#757575</item>
    </style>

    <style name="AppButton.Success" parent="AppButton">
        <item name="backgroundTint">#4CAF50</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:drawableTint">@android:color/white</item>
    </style>

    <style name="AppButton.Warning" parent="AppButton">
        <item name="backgroundTint">#FF9800</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:drawableTint">@android:color/white</item>
    </style>

    <style name="AppButton.Info" parent="AppButton">
        <item name="backgroundTint">#607D8B</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:drawableTint">@android:color/white</item>
    </style>
</resources>